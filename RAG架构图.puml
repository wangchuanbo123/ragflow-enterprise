@startuml
title 当前 RAG 项目分层架构

top to bottom direction
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center

actor "用户 / Web 前端" as User

component "FastAPI 接口层  app/api\n/ask · /api/v1/chat · /documents\n/index-jobs · /knowledge-graph · /ready" as API

package "应用服务层  app/services" {
  component "在线问答\nChatService + RAGService" as OnlineService
  component "文档与图谱任务\nDocumentIndexService + IndexWorker\nGraphBuildService" as OfflineService
  component "运行状态\nReadinessService" as ReadyService
}

package "在线 RAG 主链" {
  component "问答编排\n/ask：Compiled LangGraph\nWeb：RAGService 手工调用共享节点" as Flow
  component "rag/nodes 五个节点\nrewrite → retrieve → rerank\n→ build_context → generate" as Nodes
  component "HybridGraphRetriever\nVector + 中文 BM25 + Knowledge Graph\nWeighted RRF 融合" as Retrieval
}

package "离线处理主链" {
  component "IndexManager + Chunker\n文档解析、切片、增量索引" as IndexCore
  component "GraphExtractor\n实体、关系与证据抽取" as GraphCore
}

package "基础设施抽象" {
  component "Provider 工厂\nLLM · Embedding · Reranker · Vector Store" as Providers
  component "数据设施\nSQLite：业务、Chunk 元数据、图谱\nChroma：文档向量\ndata/docs：待索引业务文档" as Data
}

User --> API
API --> OnlineService : 在线问答
API --> OfflineService : 文档、索引与图谱任务
API --> ReadyService : 健康与就绪检查

OnlineService --> Flow
Flow --> Nodes
Nodes --> Retrieval : retrieve
Nodes --> Providers : rewrite / rerank / generate
Retrieval --> Providers : 向量查询
Retrieval --> Data : BM25 / 图谱证据 / 向量结果

OfflineService --> IndexCore
OfflineService --> GraphCore
IndexCore --> Providers : Embedding
GraphCore --> Providers : LLM 抽取
IndexCore --> Data : 读文档、写 Chunk 与向量
GraphCore --> Data : 写实体、关系与证据
ReadyService --> Data

note right of Flow
当前是“共享节点、两种编排入口”：
只有 /ask 调用 compiled_graph.invoke()；
Web 同步与 SSE 由 RAGService 依次调用节点函数。
所有入口共用登录鉴权、并发限制、
Provider 超时和索引版本缓存刷新。
end note

note right of Retrieval
知识图谱目前是 retrieve 内部的检索通道，
不是独立 LangGraph 节点。
end note

@enduml

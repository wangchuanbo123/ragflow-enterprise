@startuml EnterpriseRAGArchitecture
title 企业级 RAG 构建、检索与生成架构

left to right direction
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Microsoft YaHei
skinparam defaultTextAlignment center
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.2
skinparam package {
    BorderColor #94A3B8
    FontColor #0F172A
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #64748B
    FontColor #1E293B
}
skinparam database {
    BackgroundColor #FFF4CC
    BorderColor #D69E2E
    FontColor #5F4300
}
skinparam queue {
    BackgroundColor #FFE7C2
    BorderColor #DD6B20
    FontColor #7B341E
}
skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #2563EB
    FontColor #1E3A8A
}
skinparam note {
    BackgroundColor #FFFBEA
    BorderColor #D6B656
    FontColor #4A3B00
}

actor "企业用户" as User

package "一、知识构建阶段" #EAF4FF {

    rectangle "文档数据源\nPDF / Word / Markdown\nWiki / 网页 / API" as DocumentSource #DBEAFE
    rectangle "代码数据源\nGit / 本地目录" as CodeSource #DCFCE7

    package "文档处理" #EDF7FF {
        rectangle "文档解析\nOCR / 版面 / 结构解析" as DocumentParser #E0F2FE
        rectangle "文档切片\n标题 / 段落 / 表格 / Token" as DocumentChunker #E0F2FE
        rectangle "Chunk 标准化\n哈希 / 元数据 / 权限 / 版本" as ChunkNormalize #E0F2FE

        database "文档与 Chunk 库" as ChunkStore
        rectangle "Chunk 向量生成" as ChunkEmbedding #CCFBF1
        database "文档向量索引" as DocumentVectorIndex #D1FAE5
        database "BM25 / 全文索引" as BM25Index #FEF3C7

        DocumentSource -[#2563EB]-> DocumentParser
        DocumentParser --> DocumentChunker
        DocumentChunker --> ChunkNormalize

        ChunkNormalize --> ChunkStore
        ChunkNormalize --> ChunkEmbedding
        ChunkEmbedding --> DocumentVectorIndex
        ChunkNormalize --> BM25Index
    }

    package "知识图谱构建" #F5F0FF {
        rectangle "图谱 Schema\n实体类型 / 关系类型 / 约束" as GraphSchema #EDE9FE
        rectangle "实体与关系抽取\nEntity / Relation / Evidence" as GraphExtraction #F3E8FF
        rectangle "实体归一化与消歧\n别名 / 合并 / 人工修正" as EntityNormalize #F3E8FF

        database "知识图谱库\n实体 / 关系 / 证据" as GraphStore #EDE9FE

        rectangle "实体向量生成" as EntityEmbedding #CCFBF1
        database "实体向量索引" as EntityVectorIndex #D1FAE5

        rectangle "关系向量生成\n主语 + 谓词 + 宾语\n别名 + 描述 + 证据" as RelationEmbedding #CCFBF1
        database "关系向量索引" as RelationVectorIndex #D1FAE5

        ChunkStore --> GraphExtraction
        GraphSchema --> GraphExtraction
        GraphExtraction --> EntityNormalize
        EntityNormalize --> GraphStore

        GraphStore --> EntityEmbedding
        EntityEmbedding --> EntityVectorIndex

        GraphStore --> RelationEmbedding
        RelationEmbedding --> RelationVectorIndex
    }

    package "代码知识构建" #EFFAF2 {
        rectangle "代码扫描\n语言识别 / 文件过滤 / 哈希" as CodeScanner #DCFCE7
        rectangle "AST 解析" as ASTParser #DCFCE7
        rectangle "代码切片与符号提取\nFile / Class / Method / Function" as SymbolExtraction #DCFCE7
        rectangle "代码关系提取\nCalls / Imports / Extends / Depends" as CodeRelationExtraction #DCFCE7

        database "版本化代码图谱\nSnapshot / File / Symbol / Relation" as CodeGraphStore #DCFCE7

        rectangle "代码片段向量生成\n路径 + 语言 + 类型\n限定名 + 签名 + 源码" as CodeEmbedding #CCFBF1
        database "代码 Symbol 向量索引" as CodeVectorIndex #D1FAE5

        CodeSource -[#16A34A]-> CodeScanner
        CodeScanner --> ASTParser
        ASTParser --> SymbolExtraction
        SymbolExtraction --> CodeRelationExtraction
        CodeRelationExtraction --> CodeGraphStore

        CodeGraphStore --> CodeEmbedding
        CodeEmbedding --> CodeVectorIndex
    }

    queue "异步索引任务\n状态 / 重试 / 租约" as IndexJobQueue

    ChunkNormalize --> IndexJobQueue
    GraphExtraction --> IndexJobQueue
    CodeScanner --> IndexJobQueue
}

package "二、提问与路由阶段" #F4F0FF {

    rectangle "用户提问" as Question #DBEAFE
    rectangle "LLM 限制层\n认证 / 权限 / 租户隔离\n限流 / Prompt 防护" as InputGuard #FDE68A
    rectangle "检索路由器\n规则路由 / LLM 路由\n单路或多路并行" as RetrievalRouter #DDD6FE
    rectangle "自适应 Query Rewrite\n仅低置信度或多轮问题调用 LLM\n成功后以规则复核路由" as AdaptiveRewrite #EDE9FE
    rectangle "共享问题向量\n只生成一次" as SharedQueryEmbedding #CCFBF1
    rectangle "检索档位策略\n快速 / 标准 / 深度" as RetrievalPolicy #FCE7F3

    User --> Question
    Question --> InputGuard
    InputGuard --> RetrievalRouter
    RetrievalRouter --> AdaptiveRewrite
    AdaptiveRewrite --> SharedQueryEmbedding
    SharedQueryEmbedding --> RetrievalPolicy
}

package "三、多路检索与召回阶段" #EEF8F1 {

    package "文档检索通道" #EDF7FF {
        rectangle "文档检索计划\n知识库 / 权限 / 元数据过滤" as DocumentRetrieval #DBEAFE
        rectangle "向量召回\nSemantic Top-K" as DocumentVectorRecall #CCFBF1
        rectangle "词法召回\nBM25 Top-K" as BM25Recall #FEF3C7
        rectangle "文档通道融合\nRRF / 加权融合 / 去重" as DocumentFusion #FFEDD5

        RetrievalPolicy -[#2563EB]-> DocumentRetrieval

        DocumentRetrieval --> DocumentVectorRecall
        DocumentRetrieval --> BM25Recall

        DocumentVectorIndex --> DocumentVectorRecall
        BM25Index --> BM25Recall

        DocumentVectorRecall --> DocumentFusion
        BM25Recall --> DocumentFusion
    }

    package "知识图谱检索通道" #F5F0FF {
        rectangle "图谱检索计划\n实体意图 / 关系意图 / 跳数" as GraphRetrieval #EDE9FE

        rectangle "实体词法召回\n名称 / 别名 / 包含匹配" as EntityLexicalRecall #FEF3C7
        rectangle "实体向量召回\nEntity Semantic Search" as EntityVectorRecall #CCFBF1

        rectangle "关系词法召回\n谓词 / 中英文别名" as RelationLexicalRecall #FEF3C7
        rectangle "关系向量召回\nRelation Semantic Search" as RelationVectorRecall #CCFBF1

        rectangle "图谱种子融合\n实体种子 + 关系种子\n合并 / 去重 / 评分" as GraphSeedFusion #FFEDD5
        rectangle "图遍历召回\n关系端点扩展\n1 到 2 跳邻居遍历" as GraphTraversal #EDE9FE
        rectangle "关系证据回溯\nEvidence 映射到原始 Chunk" as GraphEvidenceRecall #FCE7F3

        RetrievalPolicy -[#7C3AED]-> GraphRetrieval

        GraphRetrieval --> EntityLexicalRecall
        GraphRetrieval --> EntityVectorRecall
        GraphRetrieval --> RelationLexicalRecall
        GraphRetrieval --> RelationVectorRecall

        GraphStore --> EntityLexicalRecall
        EntityVectorIndex --> EntityVectorRecall
        GraphStore --> RelationLexicalRecall
        RelationVectorIndex --> RelationVectorRecall

        EntityLexicalRecall --> GraphSeedFusion
        EntityVectorRecall --> GraphSeedFusion
        RelationLexicalRecall --> GraphSeedFusion
        RelationVectorRecall --> GraphSeedFusion

        GraphSeedFusion --> GraphTraversal
        GraphStore --> GraphTraversal

        GraphTraversal --> GraphEvidenceRecall
        GraphStore --> GraphEvidenceRecall
        ChunkStore --> GraphEvidenceRecall
    }

    package "代码检索通道" #EFFAF2 {
        rectangle "代码检索计划\n语言 / 路径 / Symbol 类型\n调用与依赖意图" as CodeRetrieval #DCFCE7

        rectangle "代码词法召回\n名称 / 限定名 / 签名" as CodeLexicalRecall #FEF3C7
        rectangle "代码向量召回\n源码语义 / 功能描述" as CodeVectorRecall #CCFBF1

        rectangle "代码候选融合\nLexical + Vector\nRRF / 去重" as CodeFusion #FFEDD5
        rectangle "代码图扩展\nCalls / Imports / Extends\n调用与依赖关系补充" as CodeGraphExpansion #DCFCE7

        RetrievalPolicy -[#16A34A]-> CodeRetrieval

        CodeRetrieval --> CodeLexicalRecall
        CodeRetrieval --> CodeVectorRecall

        CodeGraphStore --> CodeLexicalRecall
        CodeVectorIndex --> CodeVectorRecall

        CodeLexicalRecall --> CodeFusion
        CodeVectorRecall --> CodeFusion

        CodeFusion --> CodeGraphExpansion
        CodeGraphStore --> CodeGraphExpansion
    }
}

package "四、融合、重排与生成阶段" #FFF5E8 {

    rectangle "多通道召回候选\n文档 Chunk\n图谱证据 Chunk\n代码 Symbol" as RecallCandidates #E0F2FE

    rectangle "跨通道融合\n通道权重 + RRF\n统一评分 / 去重\n权限与版本过滤" as GlobalFusion #FED7AA

    rectangle "候选重排\nCross-Encoder / Reranker" as Reranker #FBCFE8

    rectangle "上下文组装\nToken Budget\n多样性控制 / 邻近片段补全\n来源与引用绑定" as ContextBuilder #EDE9FE

    rectangle "生成限制层\nSystem Prompt / 上下文边界\n最大 Token / 敏感信息策略" as GenerationGuard #FDE68A

    rectangle "LLM 答案生成\nGrounded Generation" as LLMGeneration #DDD6FE

    rectangle "答案校验\n事实一致性 / 引用检查\n无证据拒答 / 风险过滤" as AnswerValidation #FCE7F3

    rectangle "最终答案\nAnswer + Citations + Trace" as FinalAnswer #BBF7D0

    DocumentFusion -[#2563EB]-> RecallCandidates
    GraphEvidenceRecall -[#7C3AED]-> RecallCandidates
    CodeGraphExpansion -[#16A34A]-> RecallCandidates

    RecallCandidates -[#EA580C]-> GlobalFusion
    GlobalFusion -[#DB2777]-> Reranker
    Reranker -[#7C3AED]-> ContextBuilder
    ContextBuilder -[#7C3AED]-> GenerationGuard
    GenerationGuard -[#7C3AED]-> LLMGeneration
    LLMGeneration -[#DB2777]-> AnswerValidation
    AnswerValidation -[#16A34A]-> FinalAnswer
    FinalAnswer -[#16A34A]-> User
}

note bottom of RetrievalRouter
路由器根据问题选择：
1. 文档检索通道
2. 知识图谱检索通道
3. 代码检索通道

允许单通道或多通道并行检索。
end note

note bottom of GlobalFusion
先进行通道内部融合，
再进行跨通道融合，
最后统一重排。
end note

note bottom of CodeGraphStore
当前代码知识与文档知识独立存储、独立召回，
暂不建立 Code Symbol 与 Document Chunk 的显式关联。
end note

@enduml

APP_PORT=8080
IMAGE_TAG=laptop

# The deployment script replaces these placeholders on first run.
JWT_SECRET_KEY=replace-with-at-least-48-random-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# The UI is served by the same container. Add another exact origin only when
# a separate browser client needs cross-origin access.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Ollama runs on the laptop host; the container reaches it through this name.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# Keep the first laptop startup lightweight. Change to bge only when the
# machine has enough memory and the model can be downloaded in the container.
RERANKER_PROVIDER=none
QUERY_REWRITE_CONFIDENCE_THRESHOLD=0.75

CODE_FUNCTION_VECTOR_ENABLED=true
CODE_FUNCTION_SUMMARY_LLM_ENABLED=true

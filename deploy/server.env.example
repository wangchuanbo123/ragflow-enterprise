# python -m scripts.configure_server creates .env.server without printing secrets.
# Start: python -m scripts.start_server
APP_PROFILE=server
# Set an immutable registry image (sha-<commit> or @sha256:<digest>) for releases.
APP_IMAGE=rag-enterprise:team
APP_PORT=8080
# Direct LAN access may use 0.0.0.0; use a HTTPS reverse proxy for Internet access.
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
COOKIE_SECURE=false
CORS_ORIGINS=
REDIS_KEY_PREFIX=rag-enterprise
RAG_MAX_CONCURRENCY=8
RAG_QUEUE_TIMEOUT_SECONDS=30
GRAPH_FILTER_MAX_CONCURRENCY=4
GRAPH_FILTER_MAX_RECORDS=200000
INDEX_MAX_CONCURRENCY=2
BM25_MAX_CACHE_KNOWLEDGE_BASES=8
BM25_MAX_CHUNKS_PER_KNOWLEDGE_BASE=100000
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANKER_PROVIDER=none
OPENCODE_AUTO_START=true
AGENT_TIMEOUT_SECONDS=180

# Workload budgets and operational warning thresholds
UPLOAD_MAX_CONCURRENCY=4
MODEL_BUDGET_ENABLED=true
MODEL_MAX_CONCURRENCY=8
MODEL_BACKGROUND_CONCURRENCY=2
MODEL_QUEUE_TIMEOUT_SECONDS=30
JOB_PARSE_CONCURRENCY=2
JOB_VECTOR_CONCURRENCY=2
JOB_MODEL_CONCURRENCY=2
JOB_SHORT_CONCURRENCY=2
JOB_PRIORITY_AGING_SECONDS=900
OPS_QUEUE_WARN_SECONDS=300
OPS_DISK_FREE_WARN_RATIO=0.1
OPS_MEMORY_WARN_PERCENT=90
PGVECTOR_SEARCH_MODE=exact
PGVECTOR_ANN_MIN_ROWS=100000
PGVECTOR_ANN_EF_SEARCH=400
# Container defaults to /app/data/search-cache, shared by application roles.

PGVECTOR_INDEX_MEMORY_MB=256

# Single-host resource limits; calibrate on the target machine
API_CPUS=2
API_MEMORY=3g
WORKER_CPUS=4
WORKER_MEMORY=6g
SCHEDULER_CPUS=0.5
SCHEDULER_MEMORY=1536m
POSTGRES_CPUS=2
POSTGRES_MEMORY=3g
REDIS_CPUS=0.5
REDIS_MEMORY=512m
# Consistent full-server backup schedule and optional mounted off-host target
SERVER_BACKUP_INTERVAL_HOURS=24
SERVER_BACKUP_RTO_MINUTES=60
# SERVER_BACKUP_DIRECTORY=
# SERVER_BACKUP_MIRROR_DIRECTORY=
BM25_TOKEN_CACHE_ENABLED=true

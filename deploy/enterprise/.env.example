POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=ragflow-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-at-least-48-random-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
APP_PORT=8080
IMAGE_TAG=local
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# Any OpenAI-compatible gateway can be substituted without changing business code.
ANSWER_LLM_PROVIDER=openai_compatible
ANSWER_LLM_MODEL=your-answer-model
ANSWER_LLM_BASE_URL=https://model-gateway.example/v1
ANSWER_LLM_API_KEY=replace-me

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BASE_URL=https://model-gateway.example/v1
EMBEDDING_API_KEY=replace-me

RERANKER_PROVIDER=none

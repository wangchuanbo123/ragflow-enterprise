# Copy this file to .env. Keep real API keys only in .env.
# Legacy single-process compatibility/test setup only.
# Team entry: python -m scripts.start_server; see deploy/server.env.example.
# When remote LLM API values are empty, the LLM falls back to local Ollama.
APP_PROFILE=local
METADATA_STORE_PROVIDER=sqlite
OBJECT_STORE_PROVIDER=local
LOCAL_OBJECT_STORE_DIR=data/docs
LOCAL_SOURCE_ALLOWED_ROOTS=data/docs
TASK_QUEUE_PROVIDER=inline
CACHE_PROVIDER=memory

LLM_PROVIDER=zhipu
LLM_MODEL=glm-5.2
LLM_API_KEY=
LLM_BASE_URL=

# Optional per-purpose overrides. Empty values inherit LLM_*.
ANSWER_LLM_PROVIDER=
ANSWER_LLM_MODEL=
ANSWER_LLM_API_KEY=
ANSWER_LLM_BASE_URL=
REWRITE_LLM_PROVIDER=
REWRITE_LLM_MODEL=
REWRITE_LLM_API_KEY=
REWRITE_LLM_BASE_URL=
ROUTER_LLM_PROVIDER=
ROUTER_LLM_MODEL=
ROUTER_LLM_API_KEY=
ROUTER_LLM_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANK_TOP_K=5

VECTOR_STORE_PROVIDER=chroma_embedded

APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
MAX_HISTORY_MESSAGES=10
MAX_MESSAGE_LENGTH=4000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTRATION_MAX_ATTEMPTS=3
AUTH_REGISTRATION_IP_MAX_ATTEMPTS=20
AUTH_REGISTRATION_WINDOW_SECONDS=3600

# Knowledge agent codecode: pinned V2 v2.2.5 runtime from the private dependency manifest.
# prepare_codecode --install-runtime builds with project-local Bun 1.4.4
# managed under data/agents/build-tools/; no global Bun is required.
# Windows runtime: integrations/codecode/runtime/codecode.exe (see source.json).
# Built from packages/cli for background serve usage with --skip-web-ui.
# The project's own Vue knowledge workbench is built and served separately.
# Project startup uses only the verified project-local runtime.
# Personal global CLI upgrades are independent of this pinned project runtime.
AGENT_BACKEND=codecode
CODECODE_AUTO_START=true
CODECODE_BASE_URL=http://127.0.0.1:4096
# Managed runtime authentication identity.
CODECODE_SERVER_USERNAME=codecode
# Empty: generated for the managed child process without changing personal codecode config.
CODECODE_PASSWORD=
# CODECODE_PASSWORD configures the managed runtime authentication secret.
# V2 runtime config uses providers/package/settings, agents/system, permissions and policies.
# Isolated versioned state/logs: data/agents/runtime/v2.2.5/ (no V1 state reuse).
CODECODE_MODEL=
# Empty uses the canonical project-built executable above; no PATH/global fallback.
CODECODE_EXECUTABLE=
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_STEPS=12
AGENT_TOOL_URL=
# Optional server-managed alternate agent profiles; never accepted from task payloads.
AGENT_BACKEND_PROFILES_JSON={}

# Index and chunking
INDEX_SCHEMA_VERSION=2
# recursive | semantic | code_aware（code_aware 保护文档内代码块不被切断）
CHUNK_STRATEGY=code_aware
CHUNK_SIZE=384
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=80
INGEST_BATCH_SIZE=128
MAX_DOCUMENT_SIZE_MB=50
MAX_BATCH_UPLOAD_FILES=100
MAX_BATCH_UPLOAD_TOTAL_MB=500
INDEX_WORKER_ENABLED=true
INDEX_MAX_CONCURRENCY=1
INDEX_JOB_LEASE_SECONDS=300
INDEX_JOB_HEARTBEAT_SECONDS=30
INDEX_JOB_MAX_ATTEMPTS=3
INDEX_JOB_RECONCILE_SECONDS=30

# Document images（图片提取通道）
IMAGE_EXTRACTION_ENABLED=true
MAX_IMAGES_PER_DOCUMENT=40
MAX_IMAGE_BYTES=8388608
IMAGE_CONTEXT_MAX_PER_CHUNK=3
IMAGE_URL_PREFIX=/api/v1/objects

# Code blocks inside documents（文档代码图谱）
CODE_AWARE_MIN_BLOCK_LINES=3
DOCUMENT_CODE_GRAPH_ENABLED=true
DOCUMENT_CODE_MAX_BLOCKS=60
DOCUMENT_CODE_MIN_BLOCK_LINES=3

# Retrieval
QUERY_REWRITE_ENABLED=true
VECTOR_SEARCH_K=8
BM25_SEARCH_K=8
HYBRID_VECTOR_WEIGHT=0.70
RRF_K=60
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_ROUTER_MODE=rules
ROUTER_LLM_ENABLED=false
QUERY_REWRITE_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_SCOPE_MAX_IDS=100
RERANK_TOP_K=5

# Context
MAX_CONTEXT_TOKENS=3000
MAX_CONTEXT_CHUNKS=5
MAX_CHUNKS_PER_SOURCE=2
CONTEXT_TOKEN_SAFETY_RATIO=0.85
CONTEXT_JSON_EXPORT_ENABLED=false
CONTEXT_JSON_EXPORT_DIR=data/debug/contexts

# Runtime reliability
RAG_MAX_CONCURRENCY=2
RAG_QUEUE_TIMEOUT_SECONDS=3
PROVIDER_TIMEOUT_SECONDS=120
READINESS_TIMEOUT_SECONDS=2
READINESS_CACHE_SECONDS=10

# Chroma usage telemetry is disabled for local/offline operation.
ANONYMIZED_TELEMETRY=False

# Knowledge graph
# Production reasoning uses AGENT_BACKEND/CODECODE_MODEL. Historical
# GRAPH_EXTRACTION_* model settings remain for explicit legacy-provider compatibility only.
KNOWLEDGE_GRAPH_ENABLED=true
GRAPH_STORE_PROVIDER=sqlite
GRAPH_EXTRACTION_PROVIDER=current
GRAPH_EXTRACTION_MODEL=glm-5.2
GRAPH_EXTRACTION_API_KEY=
GRAPH_EXTRACTION_BASE_URL=
GRAPH_AUTO_BUILD_ENABLED=true
GRAPH_SCHEMA_AUTO_GENERATE_ENABLED=true
GRAPH_SCHEMA_SAMPLE_DOCUMENTS=30
GRAPH_SCHEMA_SAMPLE_CHUNKS_PER_DOCUMENT=3
GRAPH_SCHEMA_SAMPLE_MAX_CHARS=40000
GRAPH_SCHEMA_VERSION=1
GRAPH_EXTRACTION_BATCH_SIZE=6
GRAPH_EXTRACTION_MAX_CHARS=6000
GRAPH_EXTRACTION_MAX_RETRIES=1
GRAPH_MIN_CONFIDENCE=0.60
GRAPH_ENTITY_SEARCH_K=5
GRAPH_RELATION_SEARCH_K=8
GRAPH_MAX_HOPS=2
GRAPH_MAX_RELATIONS=50
GRAPH_CACHE_ENABLED=true
GRAPH_PARALLEL_WORKERS=2
GRAPH_RELATED_TO_MAX_RATIO=0.35
GRAPH_LOW_CONFIDENCE_REVIEW_THRESHOLD=0.75
GRAPH_ENTITY_VECTOR_ENABLED=true
GRAPH_RELATION_VECTOR_ENABLED=true
GRAPH_ENTITY_MERGE_SIMILARITY=0.92
GRAPH_MERGE_CANDIDATE_LIMIT=200

# Graph incremental build: debounce, profiles, pre-filter, escalation
GRAPH_AUTO_BUILD_DEBOUNCE_SECONDS=60
GRAPH_AUTO_BUILD_MIN_PENDING_CHUNKS=20
GRAPH_AUTO_BUILD_MAX_WAIT_SECONDS=300
GRAPH_AUTO_BUILD_PROFILE=fast
GRAPH_PREFILTER_ENABLED=true
GRAPH_PREFILTER_MIN_CHARS=24
# Legacy explicit-LLM compatibility settings; production extraction uses
# AgentBackend review/repair. Select a registered runtime_profile in agent tasks.
GRAPH_ESCALATION_PROVIDER=current
GRAPH_ESCALATION_MODEL=
GRAPH_ESCALATION_API_KEY=
GRAPH_ESCALATION_BASE_URL=
GRAPH_ESCALATION_MIN_CONFIDENCE=0.75
# Deferred community maintenance (off-peak window example: 22-6, empty = always)
GRAPH_COMMUNITY_MAINTENANCE_ENABLED=true
GRAPH_COMMUNITY_MAINTENANCE_INTERVAL_SECONDS=600
GRAPH_COMMUNITY_MAINTENANCE_WINDOW=

# Code parser / symbol and call graph
CODE_GRAPH_ENABLED=true
CODE_PARSE_WORKERS=4
CODE_MAX_FILE_SIZE_MB=2
CODE_SNAPSHOT_RETENTION=3
CODE_SEARCH_K=12
CODE_VECTOR_ENABLED=true
CODE_VECTOR_SEARCH_K=12
CODE_VECTOR_MAX_CHARS=6000
CODE_FUNCTION_VECTOR_ENABLED=true
# Historical setting name: enables AgentBackend code summaries in production.
CODE_FUNCTION_SUMMARY_LLM_ENABLED=true
CODE_FUNCTION_SUMMARY_BATCH_SIZE=8
CODE_FUNCTION_SUMMARY_MAX_SOURCE_CHARS=3000
CODE_FUNCTION_SUMMARY_MAX_CHARS=800
CODE_FUNCTION_SUMMARY_RELATION_LIMIT=12

# Connector scheduling
CONNECTOR_SCHEDULER_ENABLED=true
BACKUP_MONTHLY_ENABLED=true
BACKUP_MONTHLY_INTERVAL_DAYS=30
BACKUP_RETENTION_VERSIONS=12
BACKUP_SCHEDULER_INTERVAL_SECONDS=86400
CONNECTOR_SCHEDULER_INTERVAL_SECONDS=60
CONNECTOR_GIT_TIMEOUT_SECONDS=300
CONNECTOR_MAX_DOWNLOAD_MB=512
# Server-managed connector permissions. Use actual knowledge-base IDs.
# Example: {"kb-id":["D:/sources/team"]}; also list these roots in LOCAL_SOURCE_ALLOWED_ROOTS.
LOCAL_SOURCE_ROOTS_JSON={}
# Example: {"docs-git":{"secret_ref":"env://DOCS_TOKEN","knowledge_base_ids":["kb-id"],"source_type":"git","allowed_locations":["https://git.example/team/docs.git"]}}
# Users select credential://docs-git; raw env:// and file:// references are not accepted.
CONNECTOR_CREDENTIALS_JSON={}

# Multi-channel retrieval
VECTOR_RETRIEVAL_WEIGHT=0.50
BM25_RETRIEVAL_WEIGHT=0.25
GRAPH_RETRIEVAL_WEIGHT=0.25
CODE_RETRIEVAL_WEIGHT=0.25

# Workload budgets and operational warning thresholds
UPLOAD_MAX_CONCURRENCY=4
MODEL_BUDGET_ENABLED=true
MODEL_MAX_CONCURRENCY=8
MODEL_BACKGROUND_CONCURRENCY=2
MODEL_QUEUE_TIMEOUT_SECONDS=30
JOB_PARSE_CONCURRENCY=2
JOB_VECTOR_CONCURRENCY=2
JOB_MODEL_CONCURRENCY=2
JOB_SHORT_CONCURRENCY=2
JOB_PRIORITY_AGING_SECONDS=900
OPS_QUEUE_WARN_SECONDS=300
OPS_DISK_FREE_WARN_RATIO=0.1
OPS_MEMORY_WARN_PERCENT=90
PGVECTOR_SEARCH_MODE=exact
PGVECTOR_ANN_MIN_ROWS=100000
PGVECTOR_ANN_EF_SEARCH=400
# Container defaults to /app/data/search-cache, shared by application roles.

PGVECTOR_INDEX_MEMORY_MB=256

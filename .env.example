# Copy this file to .env. Keep real API keys only in .env.
# In the local profile, the LLM falls back to Ollama when API values are empty.
# The enterprise profile fails fast instead of silently changing providers.
APP_PROFILE=local
METADATA_STORE_PROVIDER=sqlite
OBJECT_STORE_PROVIDER=local
LOCAL_OBJECT_STORE_DIR=data/docs
LOCAL_SOURCE_ALLOWED_ROOTS=data/docs
TASK_QUEUE_PROVIDER=inline
CACHE_PROVIDER=memory

# Enterprise object storage (OBJECT_STORE_PROVIDER=s3 or minio)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rag-source
S3_REGION=us-east-1
S3_PREFIX=
S3_ADDRESSING_STYLE=path

# Enterprise queue/cache (TASK_QUEUE_PROVIDER=celery, CACHE_PROVIDER=redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_INDEX_QUEUE=rag.index
CELERY_INDEX_TASK_NAME=ragflow.index.process_job
CELERY_RECONCILE_TASK_NAME=ragflow.index.reconcile
CELERY_CONNECTOR_SCHEDULE_TASK_NAME=ragflow.connectors.schedule_due
REDIS_URL=redis://localhost:6379/2
REDIS_CACHE_PREFIX=ragflow

LLM_PROVIDER=zhipu
LLM_MODEL=glm-5.2
LLM_API_KEY=
LLM_BASE_URL=

# Optional per-purpose overrides. Empty values inherit LLM_*.
ANSWER_LLM_PROVIDER=
ANSWER_LLM_MODEL=
ANSWER_LLM_API_KEY=
ANSWER_LLM_BASE_URL=
REWRITE_LLM_PROVIDER=
REWRITE_LLM_MODEL=
REWRITE_LLM_API_KEY=
REWRITE_LLM_BASE_URL=
ROUTER_LLM_PROVIDER=
ROUTER_LLM_MODEL=
ROUTER_LLM_API_KEY=
ROUTER_LLM_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANK_TOP_K=5

VECTOR_STORE_PROVIDER=chroma_embedded
CHROMA_HTTP_HOST=localhost
CHROMA_HTTP_PORT=8000
CHROMA_HTTP_SSL=false
CHROMA_HTTP_TENANT=default_tenant
CHROMA_HTTP_DATABASE=default_database
CHROMA_HTTP_AUTH_TOKEN=

APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
MAX_HISTORY_MESSAGES=10
MAX_MESSAGE_LENGTH=4000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Index and chunking
INDEX_SCHEMA_VERSION=2
CHUNK_STRATEGY=recursive
CHUNK_SIZE=384
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=80
INGEST_BATCH_SIZE=128
MAX_DOCUMENT_SIZE_MB=50
MAX_BATCH_UPLOAD_FILES=100
MAX_BATCH_UPLOAD_TOTAL_MB=500
INDEX_WORKER_ENABLED=true
INDEX_MAX_CONCURRENCY=1
INDEX_JOB_LEASE_SECONDS=300
INDEX_JOB_HEARTBEAT_SECONDS=30
INDEX_JOB_MAX_ATTEMPTS=3
INDEX_JOB_RECONCILE_SECONDS=30

# Retrieval
QUERY_REWRITE_ENABLED=true
VECTOR_SEARCH_K=8
BM25_SEARCH_K=8
HYBRID_VECTOR_WEIGHT=0.70
RRF_K=60
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_ROUTER_MODE=rules
ROUTER_LLM_ENABLED=false
QUERY_REWRITE_CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_SCOPE_MAX_IDS=100
RERANK_TOP_K=5

# Context
MAX_CONTEXT_TOKENS=3000
MAX_CONTEXT_CHUNKS=5
MAX_CHUNKS_PER_SOURCE=2
CONTEXT_TOKEN_SAFETY_RATIO=0.85
CONTEXT_JSON_EXPORT_ENABLED=false
CONTEXT_JSON_EXPORT_DIR=data/debug/contexts

# Runtime reliability
RAG_MAX_CONCURRENCY=2
RAG_QUEUE_TIMEOUT_SECONDS=3
PROVIDER_TIMEOUT_SECONDS=120
READINESS_TIMEOUT_SECONDS=2
READINESS_CACHE_SECONDS=10

# Chroma usage telemetry is disabled for local/offline operation.
ANONYMIZED_TELEMETRY=False

# Knowledge graph
KNOWLEDGE_GRAPH_ENABLED=true
GRAPH_STORE_PROVIDER=sqlite
GRAPH_EXTRACTION_PROVIDER=current
GRAPH_EXTRACTION_MODEL=glm-5.2
GRAPH_EXTRACTION_API_KEY=
GRAPH_EXTRACTION_BASE_URL=
GRAPH_AUTO_BUILD_ENABLED=true
GRAPH_SCHEMA_VERSION=1
GRAPH_EXTRACTION_BATCH_SIZE=6
GRAPH_EXTRACTION_MAX_CHARS=6000
GRAPH_EXTRACTION_MAX_RETRIES=1
GRAPH_MIN_CONFIDENCE=0.60
GRAPH_ENTITY_SEARCH_K=5
GRAPH_RELATION_SEARCH_K=8
GRAPH_MAX_HOPS=2
GRAPH_MAX_RELATIONS=50
GRAPH_CACHE_ENABLED=true
GRAPH_PARALLEL_WORKERS=2
GRAPH_RELATED_TO_MAX_RATIO=0.35
GRAPH_LOW_CONFIDENCE_REVIEW_THRESHOLD=0.75
GRAPH_ENTITY_VECTOR_ENABLED=true
GRAPH_RELATION_VECTOR_ENABLED=true
GRAPH_ENTITY_MERGE_SIMILARITY=0.92
GRAPH_MERGE_CANDIDATE_LIMIT=200

# Graph incremental build: debounce, profiles, pre-filter, escalation
GRAPH_AUTO_BUILD_DEBOUNCE_SECONDS=60
GRAPH_AUTO_BUILD_MIN_PENDING_CHUNKS=20
GRAPH_AUTO_BUILD_MAX_WAIT_SECONDS=300
GRAPH_AUTO_BUILD_PROFILE=fast
GRAPH_PREFILTER_ENABLED=true
GRAPH_PREFILTER_MIN_CHARS=24
# Escalation model for empty/low-confidence extractions ("current" disables it)
GRAPH_ESCALATION_PROVIDER=current
GRAPH_ESCALATION_MODEL=
GRAPH_ESCALATION_API_KEY=
GRAPH_ESCALATION_BASE_URL=
GRAPH_ESCALATION_MIN_CONFIDENCE=0.75
# Deferred community maintenance (off-peak window example: 22-6, empty = always)
GRAPH_COMMUNITY_MAINTENANCE_ENABLED=true
GRAPH_COMMUNITY_MAINTENANCE_INTERVAL_SECONDS=600
GRAPH_COMMUNITY_MAINTENANCE_WINDOW=
CELERY_GRAPH_MAINTENANCE_TASK_NAME=ragflow.graph.schedule_maintenance

# Code parser / symbol and call graph
CODE_GRAPH_ENABLED=true
CODE_PARSE_WORKERS=4
CODE_MAX_FILE_SIZE_MB=2
CODE_SNAPSHOT_RETENTION=3
CODE_SEARCH_K=12
CODE_VECTOR_ENABLED=true
CODE_VECTOR_SEARCH_K=12
CODE_VECTOR_MAX_CHARS=6000
CODE_FUNCTION_VECTOR_ENABLED=true
CODE_FUNCTION_SUMMARY_LLM_ENABLED=true
CODE_FUNCTION_SUMMARY_BATCH_SIZE=8
CODE_FUNCTION_SUMMARY_MAX_SOURCE_CHARS=3000
CODE_FUNCTION_SUMMARY_MAX_CHARS=800
CODE_FUNCTION_SUMMARY_RELATION_LIMIT=12

# Connector scheduling
CONNECTOR_SCHEDULER_ENABLED=true
CONNECTOR_SCHEDULER_INTERVAL_SECONDS=60
CONNECTOR_GIT_TIMEOUT_SECONDS=300
CONNECTOR_MAX_DOWNLOAD_MB=512

# Multi-channel retrieval
VECTOR_RETRIEVAL_WEIGHT=0.50
BM25_RETRIEVAL_WEIGHT=0.25
GRAPH_RETRIEVAL_WEIGHT=0.25
CODE_RETRIEVAL_WEIGHT=0.25

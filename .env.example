# Copy this file to .env. Keep real API keys only in .env.
# The LLM falls back to Ollama when either API value is empty.
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5.2
LLM_API_KEY=
LLM_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe

RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=5

VECTOR_STORE_PROVIDER=chroma

APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
MAX_HISTORY_MESSAGES=10
MAX_MESSAGE_LENGTH=4000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Index and chunking
INDEX_SCHEMA_VERSION=2
CHUNK_STRATEGY=recursive
CHUNK_SIZE=384
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=80
INGEST_BATCH_SIZE=128
MAX_DOCUMENT_SIZE_MB=50
INDEX_WORKER_ENABLED=true
INDEX_MAX_CONCURRENCY=1

# Retrieval
QUERY_REWRITE_ENABLED=true
VECTOR_SEARCH_K=8
BM25_SEARCH_K=8
HYBRID_VECTOR_WEIGHT=0.70
RRF_K=60
RETRIEVAL_CANDIDATE_K=12
RERANK_TOP_K=5

# Context
MAX_CONTEXT_TOKENS=3000
MAX_CONTEXT_CHUNKS=5
MAX_CHUNKS_PER_SOURCE=2
CONTEXT_TOKEN_SAFETY_RATIO=0.85
CONTEXT_JSON_EXPORT_ENABLED=false
CONTEXT_JSON_EXPORT_DIR=data/debug/contexts

# Runtime reliability
RAG_MAX_CONCURRENCY=2
RAG_QUEUE_TIMEOUT_SECONDS=3
PROVIDER_TIMEOUT_SECONDS=120
READINESS_TIMEOUT_SECONDS=2
READINESS_CACHE_SECONDS=10

# Chroma usage telemetry is disabled for local/offline operation.
ANONYMIZED_TELEMETRY=False

# Knowledge graph
KNOWLEDGE_GRAPH_ENABLED=true
GRAPH_STORE_PROVIDER=sqlite
GRAPH_EXTRACTION_PROVIDER=current
GRAPH_EXTRACTION_MODEL=glm-5.2
GRAPH_SCHEMA_VERSION=1
GRAPH_EXTRACTION_BATCH_SIZE=6
GRAPH_EXTRACTION_MAX_CHARS=6000
GRAPH_EXTRACTION_MAX_RETRIES=1
GRAPH_MIN_CONFIDENCE=0.60
GRAPH_ENTITY_SEARCH_K=5
GRAPH_MAX_HOPS=2
GRAPH_MAX_RELATIONS=50

# Three-way retrieval
VECTOR_RETRIEVAL_WEIGHT=0.50
BM25_RETRIEVAL_WEIGHT=0.25
GRAPH_RETRIEVAL_WEIGHT=0.25
